#!/usr/bin/env python3
"""Portable lifecycle hook runner for coding agents."""

from __future__ import annotations

import argparse
import fnmatch
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Literal, Mapping


SHELL_COMMAND_START = (
    r"(?:^|[;&|(){}`\n]\s*)"
    r"(?:(?:then|do|else)\s+)?"
    r"(?:(?:(?:sudo|doas)"
    r"(?:\s+(?:-u\s+[^\s;&|(){}]+|--user(?:=[^\s;&|(){}]+|\s+[^\s;&|(){}]+)|-[^\s;&|(){}]+))*"
    r"|(?:command|exec|env|nohup|time)"
    r"(?:\s+(?:-[^\s;&|(){}]+|[A-Za-z_]\w*=[^\s;&|(){}]+))*)\s+)*"
)

DESTRUCTIVE_COMMANDS = (
    (
        re.compile(
            SHELL_COMMAND_START
            + r"rm\b"
            r"(?=[^;&|\n]*\s-\S*r)"
            r"(?=[^;&|\n]*\s-\S*f)",
            re.IGNORECASE,
        ),
        "rm -rf",
    ),
    (re.compile(r"\bgit\s+reset\s+--hard\b", re.IGNORECASE), "git reset --hard"),
    (
        re.compile(
            r"\bgit\s+push\b"
            r"(?:(?!\s--(?=\s|[;&|]|$))[^;&|\n])*\s(?:"
            r"--force(?:-with-lease(?:=[^\s;&|]+)?)?|-f"
            r")(?=\s|[;&|]|$)",
            re.IGNORECASE,
        ),
        "git push --force",
    ),
    (
        re.compile(
            SHELL_COMMAND_START
            + r"(?:curl|wget)\b[^\n|]*\|\s*"
            + r"(?:(?:(?:/[A-Za-z0-9._+-]+)*/)?"
            + r"(?:(?:sudo|doas)"
            + r"(?:\s+(?:-u\s+[^\s;&|(){}]+|--user"
            + r"(?:=[^\s;&|(){}]+|\s+[^\s;&|(){}]+)|-[^\s;&|(){}]+))*"
            + r"|(?:command|exec|env|nohup|time)"
            + r"(?:\s+(?:-[^\s;&|(){}]+|[A-Za-z_]\w*=[^\s;&|(){}]+))*"
            + r")\s+)*"
            + r"(?:(?:/[A-Za-z0-9._+-]+)*/)?(?:ba|z)?sh\b",
            re.IGNORECASE,
        ),
        "remote script pipe",
    ),
)


def shell_executable_text(command: str) -> str:
    """Mask quoted literals but retain executable command substitutions."""
    executable = [" "] * len(command)

    def scan(index: int, terminator: str | None = None) -> int:
        while index < len(command):
            character = command[index]
            if character == terminator:
                executable[index] = character
                return index + 1
            if character == "'":
                index += 1
                while index < len(command) and command[index] != "'":
                    index += 1
                index += index < len(command)
                continue
            if character == '"':
                index = scan_double_quote(index + 1)
                continue
            if character == "`":
                executable[index] = character
                index = scan(index + 1, "`")
                continue
            if command.startswith("$(", index):
                executable[index : index + 2] = "$("
                index = scan(index + 2, ")")
                continue
            if terminator == ")" and character == "(":
                executable[index] = character
                index = scan(index + 1, ")")
                continue
            executable[index] = character
            index += 1
        return index

    def scan_double_quote(index: int) -> int:
        while index < len(command):
            if command[index] == '"':
                return index + 1
            if command[index] == "\\":
                index += 2
                continue
            if command[index] == "`":
                executable[index] = "`"
                index = scan(index + 1, "`")
                continue
            if command.startswith("$(", index):
                executable[index : index + 2] = "$("
                index = scan(index + 2, ")")
                continue
            index += 1
        return index

    scan(0)
    return "".join(executable)

EVENT_NAMES = {
    "PreToolUse": "before_tool",
    "PostToolUse": "after_tool",
    "Stop": "stop",
}

GEMINI_EVENT_NAMES = {
    "BeforeTool": "before_tool",
    "AfterTool": "after_tool",
    "SessionEnd": "stop",
}


@dataclass(frozen=True)
class AdapterSpec:
    event_names: Mapping[str, str] | None
    output_style: Literal["canonical", "claude", "gemini"]


@dataclass(frozen=True)
class HookResult:
    decision: Literal["allow", "deny"]
    exit_code: int = 0
    message: str | None = None


@dataclass(frozen=True)
class LoadedConfig:
    config: dict[str, Any]
    repository_root: Path
    path: Path | None = None
    warning: str | None = None


ADAPTERS = {
    "canonical": AdapterSpec(None, "canonical"),
    "claude": AdapterSpec(EVENT_NAMES, "claude"),
    "codex": AdapterSpec(EVENT_NAMES, "claude"),
    "vscode": AdapterSpec(EVENT_NAMES, "claude"),
    "gemini": AdapterSpec(GEMINI_EVENT_NAMES, "gemini"),
}

PATCH_FILE_PATTERN = re.compile(
    r"^\*\*\* ((?:Add|Update|Delete) File|Move to): (.+)$", re.MULTILINE
)

DEFAULT_PROTECTED_PATHS = (
    ".git/**",
    ".env",
    ".env.*",
    "*.pem",
    "*.key",
    "secrets/**",
    "**/secrets/**",
)

TRUST_STORE_ENV = "AGENT_HOOKS_TRUST_STORE"
TRUST_STORE_VERSION = 1
TRUST_DIGEST_FIELD = "quality_after_write_sha256"

CANONICAL_EFFECTS = frozenset(
    {"filesystem_write", "shell_execute", "read_only", "unknown"}
)

# Raw vendor tool names are intentionally confined to this adapter seam. Shared
# policy below consumes only the normalized ``tool.effect`` value.
WRITE_TOOL_NAMES = {
    "apply_patch",
    "create_file",
    "edit",
    "editfiles",
    "inserteditintofile",
    "insert_edit_into_file",
    "multiedit",
    "multireplacestringinfile",
    "multi_replace_string_in_file",
    "notebookedit",
    "replace",
    "replacestringinfile",
    "replace_string_in_file",
    "write",
    "write_file",
}

SHELL_TOOL_NAMES = {
    "bash",
    "execute",
    "exec_command",
    "monitor",
    "powershell",
    "run_command",
    "run_in_terminal",
    "run_shell_command",
    "runinterminal",
    "runterminalcommand",
    "shell",
}

READ_TOOL_NAMES = {
    "glob",
    "grep",
    "list_directory",
    "listdirectory",
    "read",
    "read_file",
    "readfile",
    "read_many_files",
    "readmanyfiles",
    "search_file_content",
    "searchfilecontent",
    "webfetch",
    "websearch",
}

VSCODE_TOOL_NAMES = {
    "create_file",
    "editfiles",
    "replace_string_in_file",
    "runterminalcommand",
}


def normalize(adapter: str, raw: dict[str, Any]) -> dict[str, Any]:
    adapter_spec = ADAPTERS[adapter]
    if adapter_spec.event_names is None:
        event = dict(raw)
        raw_tool = raw.get("tool") or {}
        tool = dict(raw_tool) if isinstance(raw_tool, dict) else {}
        tool["effect"] = classify_effect(tool)
        event["tool"] = tool
        return event

    tool_input = raw.get("tool_input") or {}
    if not isinstance(tool_input, dict):
        tool_input = {}
    tool_name = raw.get("tool_name") or ""
    event_name = adapter_spec.event_names.get(
        raw.get("hook_event_name"), "unknown"
    )
    files = extract_files(
        tool_name,
        tool_input,
        after_tool=event_name == "after_tool",
    )
    return {
        "schema": "agent-hooks/v1",
        "event": event_name,
        "cwd": raw.get("cwd"),
        "agent": adapter,
        "tool": {
            "name": tool_name,
            "effect": classify_effect(
                {
                    "name": tool_name,
                    "command": tool_input.get("command"),
                    "files": files,
                }
            ),
            "command": tool_input.get("command"),
            "file": files[0] if files else None,
            "files": files,
        },
    }


def classify_effect(tool: Mapping[str, Any]) -> str:
    """Return the stable policy effect for an adapter or canonical tool."""
    explicit_effect = tool.get("effect")
    if (
        isinstance(explicit_effect, str)
        and explicit_effect in CANONICAL_EFFECTS
        and explicit_effect != "unknown"
    ):
        return explicit_effect

    tool_name = str(tool.get("name") or "").lower()
    if tool_name in WRITE_TOOL_NAMES:
        return "filesystem_write"
    if tool_name in SHELL_TOOL_NAMES:
        return "shell_execute"
    if tool_name in READ_TOOL_NAMES:
        return "read_only"

    # Payload-shape fallback prevents new/unknown vendor aliases from bypassing
    # destructive-command or protected-path checks. A known read alias was
    # already returned above, so its file target remains readable.
    if tool.get("command") is not None:
        return "shell_execute"
    if tool_files(tool):
        return "filesystem_write"
    return "unknown"


def resolve_adapter(adapter: str, raw: Mapping[str, Any]) -> str:
    if adapter != "auto":
        return adapter
    if os.environ.get("PLUGIN_ROOT"):
        return "codex"
    tool_name = str(raw.get("tool_name") or "").lower()
    if tool_name in VSCODE_TOOL_NAMES:
        return "vscode"
    return "claude"


def extract_files(
    tool_name: str,
    tool_input: dict[str, Any],
    *,
    after_tool: bool = False,
) -> list[str]:
    files: list[str] = []
    direct_path = (
        tool_input.get("file_path")
        or tool_input.get("filePath")
        or tool_input.get("path")
    )
    if isinstance(direct_path, str):
        files.append(direct_path)

    listed_paths = tool_input.get("files") or []
    for item in listed_paths if isinstance(listed_paths, list) else []:
        if isinstance(item, str):
            files.append(item)
        elif isinstance(item, dict):
            path = item.get("file_path") or item.get("filePath") or item.get("path")
            if isinstance(path, str):
                files.append(path)

    if tool_name.lower() == "apply_patch":
        command = tool_input.get("command") or ""
        patch_files = PATCH_FILE_PATTERN.findall(command)
        if after_tool:
            for index, (action, path) in enumerate(patch_files):
                next_action = (
                    patch_files[index + 1][0]
                    if index + 1 < len(patch_files)
                    else None
                )
                if action == "Delete File":
                    continue
                if action == "Update File" and next_action == "Move to":
                    continue
                files.append(path)
        else:
            files.extend(path for _, path in patch_files)

    return list(dict.fromkeys(files))


def require_string_list(value: Any, field: str) -> list[str]:
    if not isinstance(value, list) or not all(
        isinstance(item, str) for item in value
    ):
        raise ValueError(f"{field} must be an array of strings")
    return value


def validate_config(config: Any) -> dict[str, Any]:
    if not isinstance(config, dict) or config.get("version") != 1:
        raise ValueError("config version must be 1")

    safety = config.get("safety", {})
    if not isinstance(safety, dict):
        raise ValueError("safety must be an object")
    require_string_list(
        safety.get("additional_protected_paths", []),
        "safety.additional_protected_paths",
    )

    quality = config.get("quality", {})
    if not isinstance(quality, dict):
        raise ValueError("quality must be an object")
    after_write = quality.get("after_write", [])
    if not isinstance(after_write, list):
        raise ValueError("quality.after_write must be an array")
    for index, hook in enumerate(after_write):
        field = f"quality.after_write[{index}]"
        if not isinstance(hook, dict):
            raise ValueError(f"{field} must be an object")
        if not isinstance(hook.get("name"), str) or not hook["name"]:
            raise ValueError(f"{field}.name must be a non-empty string")
        require_string_list(hook.get("include", ["*"]), f"{field}.include")
        command = require_string_list(hook.get("command"), f"{field}.command")
        if not command:
            raise ValueError(f"{field}.command must not be empty")
        timeout = hook.get("timeout", 30)
        if not isinstance(timeout, (int, float)) or timeout <= 0:
            raise ValueError(f"{field}.timeout must be a positive number")

    return config


def canonical_repository_root(cwd: str | Path | None) -> Path:
    working_directory = Path(cwd or os.getcwd()).expanduser().resolve()
    return next(
        (
            directory
            for directory in (working_directory, *working_directory.parents)
            if is_git_repository_root(directory)
        ),
        working_directory,
    )


def is_git_repository_root(directory: Path) -> bool:
    marker = directory / ".git"
    if marker.is_file():
        return True
    return marker.is_dir() and (marker / "HEAD").is_file()


def load_config(path: Path | None, cwd: str | None) -> LoadedConfig:
    repository_root = canonical_repository_root(cwd)
    if path is None:
        discovered_config = repository_root / ".agent-hooks.json"
        if discovered_config.is_file():
            path = discovered_config
    else:
        path = path.expanduser().resolve()
    if path is None:
        return LoadedConfig({}, repository_root)
    try:
        with path.open(encoding="utf-8") as file:
            config = validate_config(json.load(file))
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return LoadedConfig(
            {},
            repository_root,
            path,
            f"Ignoring invalid configuration at {path}: {error}",
        )
    return LoadedConfig(config, repository_root, path)


def execution_config_digest(config: Mapping[str, Any]) -> str | None:
    hooks = config.get("quality", {}).get("after_write", [])
    if not hooks:
        return None
    effective_hooks = [
        {
            "name": hook["name"],
            "include": hook.get("include", ["*"]),
            "command": hook["command"],
            "timeout": hook.get("timeout", 30),
        }
        for hook in hooks
    ]
    encoded = json.dumps(
        effective_hooks,
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def trust_store_path() -> Path:
    override = os.environ.get(TRUST_STORE_ENV)
    if override:
        return Path(override).expanduser().resolve()
    config_home = os.environ.get("XDG_CONFIG_HOME")
    base = Path(config_home).expanduser() if config_home else Path.home() / ".config"
    return (base / "agent-hooks" / "trusted-repositories.json").resolve()


def path_is_within(path: Path, directory: Path) -> bool:
    try:
        path.relative_to(directory)
    except ValueError:
        return False
    return True


def validate_trust_store(value: Any) -> dict[str, Any]:
    if not isinstance(value, dict) or value.get("version") != TRUST_STORE_VERSION:
        raise ValueError(f"trust store version must be {TRUST_STORE_VERSION}")
    repositories = value.get("repositories")
    if not isinstance(repositories, dict):
        raise ValueError("repositories must be an object")
    for repository, entry in repositories.items():
        if not isinstance(repository, str) or not Path(repository).is_absolute():
            raise ValueError("repository keys must be absolute paths")
        if not isinstance(entry, dict):
            raise ValueError(f"trust entry for {repository} must be an object")
        digest = entry.get(TRUST_DIGEST_FIELD)
        if not isinstance(digest, str) or not re.fullmatch(
            r"[0-9a-f]{64}", digest
        ):
            raise ValueError(
                f"trust entry for {repository} has an invalid digest"
            )
    return value


def load_trust_store(
    path: Path, repository_root: Path
) -> tuple[dict[str, Any], str | None]:
    if path_is_within(path, repository_root):
        return (
            {"version": TRUST_STORE_VERSION, "repositories": {}},
            f"Ignoring trust store inside repository at {path}",
        )
    try:
        with path.open(encoding="utf-8") as file:
            return validate_trust_store(json.load(file)), None
    except FileNotFoundError:
        return {"version": TRUST_STORE_VERSION, "repositories": {}}, None
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return (
            {"version": TRUST_STORE_VERSION, "repositories": {}},
            f"Ignoring invalid trust store at {path}: {error}",
        )


def write_trust_store(path: Path, store: Mapping[str, Any]) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(
        dir=path.parent,
        prefix=f".{path.name}.",
    )
    try:
        if hasattr(os, "fchmod"):
            os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as file:
            json.dump(store, file, indent=2, sort_keys=True)
            file.write("\n")
            file.flush()
            os.fsync(file.fileno())
        os.replace(temporary_name, path)
    except BaseException:
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass
        raise


def quality_trust_status(
    config: Mapping[str, Any], repository_root: Path
) -> tuple[bool, str | None]:
    digest = execution_config_digest(config)
    if digest is None:
        return True, None
    store, warning = load_trust_store(trust_store_path(), repository_root)
    if warning:
        return False, warning
    entry = store["repositories"].get(str(repository_root), {})
    return entry.get(TRUST_DIGEST_FIELD) == digest, None


def combine_warnings(*warnings: str | None) -> str | None:
    messages = [warning for warning in warnings if warning]
    return " ".join(messages) if messages else None


def path_matches(path: str, pattern: str) -> bool:
    candidate = path.replace("\\", "/")
    while candidate.startswith("./"):
        candidate = candidate[2:]
    if "/" not in pattern:
        candidate = candidate.rsplit("/", 1)[-1]
    candidate = candidate.lower()
    pattern = pattern.lower()
    return fnmatch.fnmatchcase(candidate, pattern) or (
        "/" in pattern and fnmatch.fnmatchcase(candidate, f"*/{pattern}")
    )


def tool_files(tool: Mapping[str, Any]) -> list[str]:
    files = tool.get("files") or []
    if not files and tool.get("file"):
        files = [tool["file"]]
    return [str(path) for path in files]


def evaluate(
    event: dict[str, Any],
    config: dict[str, Any],
    quality_trusted: bool = True,
) -> HookResult:
    if event.get("event") == "after_tool":
        if not quality_trusted:
            return HookResult("allow")
        return run_quality_commands(event, config)
    if event.get("event") != "before_tool":
        return HookResult("allow")

    tool = event.get("tool") or {}
    command = str(tool.get("command") or "")
    if tool.get("effect") == "shell_execute":
        command = shell_executable_text(command)
        for pattern, label in DESTRUCTIVE_COMMANDS:
            if pattern.search(command):
                return HookResult(
                    "deny",
                    exit_code=2,
                    message=f"Blocked destructive command: {label}",
                )

    file_paths = tool_files(tool)
    extra_paths = config.get("safety", {}).get(
        "additional_protected_paths", []
    )
    protected_paths = (*DEFAULT_PROTECTED_PATHS, *extra_paths)
    if tool.get("effect") == "filesystem_write":
        for file_path in file_paths:
            if any(path_matches(file_path, pattern) for pattern in protected_paths):
                return HookResult(
                    "deny",
                    exit_code=2,
                    message=f"Blocked protected path: {file_path}",
                )

    return HookResult("allow")


def quality_commands_applicable(
    event: Mapping[str, Any], config: Mapping[str, Any]
) -> bool:
    if event.get("event") != "after_tool":
        return False
    tool = event.get("tool") or {}
    if tool.get("effect") != "filesystem_write":
        return False
    file_paths = tool_files(tool)
    for file_path in file_paths:
        for hook in config.get("quality", {}).get("after_write", []):
            if any(
                path_matches(file_path, pattern)
                for pattern in hook.get("include", ["*"])
            ):
                return True
    return False


def run_quality_commands(
    event: dict[str, Any], config: dict[str, Any]
) -> HookResult:
    tool = event.get("tool") or {}
    if tool.get("effect") != "filesystem_write":
        return HookResult("allow")
    file_paths = tool_files(tool)
    if not file_paths:
        return HookResult("allow")

    cwd = event.get("cwd") or "."
    for file_path in file_paths:
        for hook in config.get("quality", {}).get("after_write", []):
            include = hook.get("include", ["*"])
            if not any(path_matches(file_path, pattern) for pattern in include):
                continue

            command = [
                str(argument).replace("{file}", file_path).replace("{cwd}", cwd)
                for argument in hook["command"]
            ]
            try:
                completed = subprocess.run(
                    command,
                    cwd=cwd,
                    text=True,
                    capture_output=True,
                    timeout=hook.get("timeout", 30),
                    check=False,
                )
            except subprocess.TimeoutExpired:
                return HookResult(
                    "deny",
                    exit_code=2,
                    message=(
                        f"Quality hook '{hook['name']}' timed out after "
                        f"{hook.get('timeout', 30)} seconds"
                    ),
                )
            except OSError as error:
                return HookResult(
                    "deny",
                    exit_code=2,
                    message=f"Quality hook '{hook['name']}' could not run: {error}",
                )
            if completed.returncode != 0:
                detail = (completed.stderr or completed.stdout).strip()
                message = f"Quality hook '{hook['name']}' failed"
                if detail:
                    message = f"{message}: {detail}"
                return HookResult("deny", exit_code=2, message=message)

    return HookResult("allow")


def skipped_quality_warning(loaded: LoadedConfig) -> str:
    command = [
        str(Path(__file__).resolve()),
        "trust",
        "--repository",
        str(loaded.repository_root),
    ]
    if loaded.path is not None:
        command.extend(["--config", str(loaded.path)])
    config_label = str(loaded.path or ".agent-hooks.json")
    return (
        "Skipped untrusted repository quality commands. "
        f"Review {config_label}, then run: {shlex.join(command)}"
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="agent-hooks")
    subparsers = parser.add_subparsers(dest="command", required=True)
    handle = subparsers.add_parser("handle")
    handle.add_argument(
        "--adapter",
        choices=("auto", *ADAPTERS),
        required=True,
    )
    handle.add_argument("--config", type=Path)
    trust = subparsers.add_parser(
        "trust",
        help="trust executable quality configuration for a repository",
    )
    trust.add_argument("--repository", type=Path)
    trust.add_argument("--config", type=Path)
    untrust = subparsers.add_parser(
        "untrust",
        help="revoke executable quality configuration trust",
    )
    untrust.add_argument("--repository", type=Path, default=Path.cwd())
    return parser


def trust_repository(repository: Path | None, config_path: Path | None) -> int:
    if repository is None:
        repository = (
            config_path.expanduser().resolve().parent
            if config_path is not None
            else Path.cwd()
        )
    loaded = load_config(config_path, str(repository))
    if loaded.warning:
        print(f"Cannot trust configuration: {loaded.warning}", file=sys.stderr)
        return 2
    if loaded.path is None:
        print(
            f"Cannot trust configuration: no .agent-hooks.json found at "
            f"{loaded.repository_root}",
            file=sys.stderr,
        )
        return 2
    digest = execution_config_digest(loaded.config)
    if digest is None:
        print(
            f"Cannot trust configuration: {loaded.path} has no executable "
            "quality.after_write commands",
            file=sys.stderr,
        )
        return 2

    store_path = trust_store_path()
    store, warning = load_trust_store(store_path, loaded.repository_root)
    if warning:
        print(f"Cannot update trust: {warning}", file=sys.stderr)
        return 2
    store["repositories"][str(loaded.repository_root)] = {
        TRUST_DIGEST_FIELD: digest
    }
    try:
        write_trust_store(store_path, store)
    except OSError as error:
        print(f"Cannot update trust store at {store_path}: {error}", file=sys.stderr)
        return 2
    print(
        f"Trusted quality commands for {loaded.repository_root} "
        f"({digest[:12]})."
    )
    return 0


def untrust_repository(repository: Path) -> int:
    repository_root = canonical_repository_root(repository)
    store_path = trust_store_path()
    store, warning = load_trust_store(store_path, repository_root)
    if warning:
        print(f"Cannot update trust: {warning}", file=sys.stderr)
        return 2
    removed = store["repositories"].pop(str(repository_root), None)
    if removed is None:
        print(f"Quality commands for {repository_root} are not trusted.")
        return 0
    try:
        write_trust_store(store_path, store)
    except OSError as error:
        print(f"Cannot update trust store at {store_path}: {error}", file=sys.stderr)
        return 2
    print(f"Revoked quality command trust for {repository_root}.")
    return 0


def render(
    adapter: str,
    event: dict[str, Any],
    result: HookResult,
    warning: str | None,
) -> tuple[int, dict[str, Any]]:
    output_style = ADAPTERS[adapter].output_style
    if output_style == "canonical":
        output: dict[str, Any] = {"decision": result.decision}
        if result.message:
            output["message"] = result.message
        if warning:
            output["warning"] = warning
        return result.exit_code, output
    if output_style == "gemini":
        if result.decision == "deny":
            output = {"decision": "deny", "reason": result.message}
        else:
            output = {}
        if warning:
            output["systemMessage"] = warning
        return 0, output
    if result.decision == "deny":
        if event.get("event") == "after_tool":
            output = {
                "decision": "block",
                "reason": result.message,
                "hookSpecificOutput": {
                    "hookEventName": "PostToolUse",
                    "additionalContext": result.message,
                },
            }
        else:
            output = {
                "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": "deny",
                    "permissionDecisionReason": result.message,
                }
            }
    else:
        output = {}
    if warning:
        output["systemMessage"] = warning
    return 0, output


def main() -> int:
    args = build_parser().parse_args()
    if args.command == "trust":
        return trust_repository(args.repository, args.config)
    if args.command == "untrust":
        return untrust_repository(args.repository)

    raw_event = json.load(sys.stdin)
    adapter = resolve_adapter(args.adapter, raw_event)
    event = normalize(adapter, raw_event)
    loaded = load_config(args.config, event.get("cwd"))
    quality_trusted, trust_warning = quality_trust_status(
        loaded.config, loaded.repository_root
    )
    quality_skipped = not quality_trusted and quality_commands_applicable(
        event, loaded.config
    )
    warning = combine_warnings(
        loaded.warning,
        trust_warning,
        skipped_quality_warning(loaded) if quality_skipped else None,
    )
    result = evaluate(event, loaded.config, quality_trusted)
    exit_code, output = render(adapter, event, result, warning)
    json.dump(output, sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
